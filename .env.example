# Copy to .env if you need to change anything. Nothing here is a secret.

# Development: the Vite dev server forwards /api to this address, so the browser never talks to the API
# directly (no CORS, works from a phone on the same Wi-Fi).
# VITE_API_PROXY=http://127.0.0.1:3002

# Production build: full URL of the API when it is on another domain. Leave unset when the site and the
# API share one domain and /api/v1 is routed to the API.
# VITE_API_URL=https://api.example.com/api/v1/
